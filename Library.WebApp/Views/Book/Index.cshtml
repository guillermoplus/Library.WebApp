@model IEnumerable<Library.Application.Interfaces.BookResponse>
@{
    ViewData["Title"] = "Book Index";
}

<div class="container mt-4">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h1 class="mb-4">Book Index</h1>

    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-success" href="/Book/Create">Create New Book</a>
    </div>

    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Genre</th>
            <th>Year</th>
            <th>Pages</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Genre</td>
                <td>@book.PublicationYear</td>
                <td>@book.Pages</td>
                <td>
                    <div class="d-flex gap-2">
                        <a class="btn btn-secondary btn-sm" href="/Book/Details/@book.Id">Details</a>
                        <a class="btn btn-primary btn-sm" href="/Book/Edit/@book.Id">Edit</a>
                        <a class="btn btn-danger btn-sm" href="/Book/Delete/@book.Id">Delete</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <nav aria-label="Books pagination">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }
        </ul>
    </nav>
</div>